# Dependencies
node_modules/
.pnp
.pnp.*

# Build output
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# Secrets. The YouCam API key is a bearer credential with spend attached to it,
# so it must never reach the repository or the client bundle.
.env
.env.local
.env*.local
*.pem
*.key

# Personal data. Capture frames are photographs and video of a real person's
# face and are never committed. Only the scores the API returned are, which keeps
# the dataset auditable without publishing anybody's face.
#
# The extensions are listed as well as the directory because source footage
# arrives in the repository root before it is filed, and a single camera clip can
# run to several gigabytes.
/captures/
/public/captures/
*.heic
*.mov
*.MOV
*.mp4
*.MP4
*.avi
*.mkv
*.webm
*.zip

# Local scratch and tooling output
/.scratch/
*.log

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Deployment
.vercel

# Test and coverage
coverage/
.nyc_output/

# Demo production working files. Scripts are tracked; footage is not.
/broll/*
!/broll/*.md
